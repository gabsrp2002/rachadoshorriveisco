{
  "name": "rachadoshorriveisco",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "export DATABASE_URL=\"${DATABASE_URL:-file:./data/racha.db}\" && prisma generate && next dev",
    "build": "export DATABASE_URL=\"${DATABASE_URL:-file:./data/racha.db}\" && prisma generate && next build",
    "start": "next start",
    "cf:build": "export DATABASE_URL=\"${DATABASE_URL:-file:./data/racha.db}\" && prisma generate && opennextjs-cloudflare build",
    "preview": "pnpm run cf:build && pnpm run db:migrate:local && wrangler dev",
    "deploy": "pnpm run cf:build && pnpm run db:migrate:remote && wrangler deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "export DATABASE_URL=\"${DATABASE_URL:-file:./data/racha.db}\" && prisma migrate dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "CI=true wrangler d1 migrations apply DB --remote",
    "db:push": "export DATABASE_URL=\"${DATABASE_URL:-file:./data/racha.db}\" && prisma db push",
    "studio": "export DATABASE_URL=\"${DATABASE_URL:-file:./data/racha.db}\" && prisma studio",
    "postinstall": "prisma generate",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.1",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.154.0"
  }
}
