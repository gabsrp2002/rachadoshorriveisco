#!/bin/sh

echo "======================================================================"
echo "🚀 Running pre-commit checks..."
echo "======================================================================"

# 1. Database schema migration check
STAGED_FILES=$(git diff --cached --name-only)
IS_SCHEMA_STAGED=$(echo "$STAGED_FILES" | grep -E '^prisma/schema\.prisma$')

if [ -n "$IS_SCHEMA_STAGED" ]; then
  ARE_MIGRATIONS_STAGED=$(echo "$STAGED_FILES" | grep -E '^prisma/migrations/')

  if [ -z "$ARE_MIGRATIONS_STAGED" ]; then
    echo ""
    echo "======================================================================"
    echo "❌ COMMIT BLOCKED: Database schema modified without a migration!"
    echo "======================================================================"
    echo "You have staged changes in 'prisma/schema.prisma', but no migration"
    echo "file in 'prisma/migrations/' was staged for this commit."
    echo ""
    echo "To fix this:"
    echo "  1. Run 'pnpm run db:migrate' (or 'pnpm prisma migrate dev') to generate"
    echo "     a new migration file."
    echo "  2. Stage the new migration directory with 'git add prisma/migrations/'"
    echo "  3. Retry your commit."
    echo "======================================================================"
    echo ""
    exit 1
  fi
fi

# 2. Ensure dependencies are installed
echo ""
echo "📦 Ensuring dependencies are installed (pnpm install)..."
pnpm install
if [ $? -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo "❌ COMMIT BLOCKED: 'pnpm install' failed!"
  echo "======================================================================"
  echo "Please check your package dependencies and try again."
  echo "======================================================================"
  echo ""
  exit 1
fi

# 3. TypeScript typecheck
echo ""
echo "🔍 Running TypeScript typecheck (pnpm run typecheck)..."
pnpm run typecheck
if [ $? -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo "❌ COMMIT BLOCKED: TypeScript typecheck failed!"
  echo "======================================================================"
  echo "Please fix the TypeScript errors above before committing."
  echo "======================================================================"
  echo ""
  exit 1
fi

# 4. ESLint check
echo ""
echo "🧹 Running ESLint (pnpm run lint)..."
pnpm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo "❌ COMMIT BLOCKED: ESLint check failed!"
  echo "======================================================================"
  echo "Please fix the linting errors above before committing."
  echo "Note: Wildcard imports (import * as ...) and relative imports are not allowed."
  echo "Use named imports and '@/' alias imports instead."
  echo "======================================================================"
  echo ""
  exit 1
fi

# 5. Unit tests check
echo ""
echo "🧪 Running Unit Tests (pnpm test)..."
pnpm test
if [ $? -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo "❌ COMMIT BLOCKED: Unit tests failed!"
  echo "======================================================================"
  echo "Please fix the failing tests above before committing."
  echo "======================================================================"
  echo ""
  exit 1
fi

# 6. Production build check
echo ""
echo "🏗️  Running build check (pnpm run build)..."
export DATABASE_URL="${DATABASE_URL:-file:./data/racha.db}"

pnpm run build
if [ $? -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo "❌ COMMIT BLOCKED: Build check failed!"
  echo "======================================================================"
  echo "Please fix the build errors above before committing."
  echo "======================================================================"
  echo ""
  exit 1
fi

echo ""
echo "======================================================================"
echo "✅ All pre-commit checks passed successfully!"
echo "======================================================================"
exit 0
